# ==============================================================================
# Database Configuration (Optional)
# If omitted or empty, Evidra runs using its fast in-memory catalog and store.
# To connect to an external PostgreSQL instance (Neon, Supabase, Railway, etc.):
# ==============================================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplement_app?sslmode=disable

# ==============================================================================
# OpenAI API (Optional)
# Used to polish consultation notes into clear, calm summaries.
# If omitted, Evidra generates structured monographs and notes deterministically.
# ==============================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Node Environment
# ==============================================================================
NODE_ENV=production
PORT=3000
